# ============================================================================
# TicketFlow — Variables d'environnement (exemple)
# Copier ce fichier en .env puis renseigner les valeurs réelles.
# Le fichier .env est lu par docker-compose.yml (directive env_file).
# Ne JAMAIS committer le fichier .env contenant des secrets réels.
# ============================================================================

# --- PostgreSQL ---
POSTGRES_USER=ticketflow
POSTGRES_PASSWORD=ticketflow
POSTGRES_DB=postgres

# --- Keycloak (authentification OIDC) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Telegram Bot (à fournir — Q4: C) ---
TELEGRAM_BOT_TOKEN=replace_me_with_real_token
TELEGRAM_WEBHOOK_SECRET=replace_me_with_webhook_secret

# --- Fournisseur LLM (à fournir — Q4: C) ---
LLM_PROVIDER=openai
LLM_API_KEY=replace_me_with_real_key
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# --- MCP Tool Server (clé d'authentification service-à-service) ---
MCP_SERVER_TOKEN=ticketflow-mcp-dev-token-change-me

# --- Spring Cloud Config ---
CONFIG_GIT_URI=
CONFIG_GIT_LABEL=main
CONFIG_GIT_USERNAME=
CONFIG_GIT_PASSWORD=

# --- URLs internes (utilisées hors Compose pour le dev local) ---
CONFIG_SERVER_URL=http://localhost:8888
EUREKA_URL=http://localhost:8761/eureka/
KEYCLOAK_URL=http://localhost:9090
KEYCLOAK_ISSUER=http://localhost:9090/realms/ticketflow
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
